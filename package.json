{
  "name": "infrasol-scrum-nuevo",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:ci": "jest --runInBand --coverage --watch=false",
    "test:rules": "firebase emulators:exec --only firestore --project demo-infrasol-hu01 \"node --test tests/firestore.rules.test.cjs\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "54.0.35",
    "firebase": "11.10.0",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "jest": "29.7.0",
    "jest-expo": "54.0.18"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "collectCoverageFrom": [
      "config/firebase.js"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ]
  }
}
